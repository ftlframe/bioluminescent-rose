# Shell
command = fish

# Font
font-family = JetBrains Mono
font-size = 11

# Cursor
cursor-style = bar
cursor-color = #ff8fb1

# Window
gtk-titlebar = false
window-padding-x = 7
window-padding-y = 10
background-opacity = 0.7

# Behavior
scrollback-limit = 3000

# Colors (Bioluminescent Rose)
background = #000000
foreground = #e0def4
selection-background = #403d52
selection-foreground = #e0def4

palette = 0=#191724
